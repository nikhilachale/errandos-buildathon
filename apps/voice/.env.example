# Keep the real value in .env.local. Never commit it or expose it to the phone client.
OPENAI_API_KEY=sk-your-server-managed-key
OPENAI_REALTIME_MODEL=gpt-realtime-mini
SARVAM_API_KEY=your-sarvam-server-managed-key

# Appium runs locally on the Mac.
APPIUM_URL=http://127.0.0.1:4723

# Replace this with the serial shown by `adb devices -l`.
# For wireless ADB, this is commonly the phone's IP address and debug port.
ANDROID_DEVICE_UDID=192.168.1.100:5555
